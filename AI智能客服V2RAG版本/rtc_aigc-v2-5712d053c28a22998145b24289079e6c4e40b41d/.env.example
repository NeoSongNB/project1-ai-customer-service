RTC_APP_ID=
RTC_APP_KEY=
# Optional business identifier shared by RTC and VoiceChat.
RTC_BUSINESS_ID=

# Required: credentials for signed VoiceChat OpenAPI requests.
# Also reused to sign Volcengine knowledge-base (RAG) requests.
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=

HOST=127.0.0.1
PORT=3001

# --- RAG / CustomLLM scene (server/scenes/rag.json) ---
# Public origin reachable by RTC cloud (no path). Local dev: ngrok / tunnel.
# Example: https://xxxx.ngrok-free.app
SERVER_URL=

# Ark endpoint used inside /api/chat_callback
ARK_API_KEY=
ARK_ENDPOINT_ID=

# Volcengine knowledge base
VOLC_ACCOUNT_ID=
KB_COLLECTION_NAME=
# Optional, default "default"
KB_PROJECT_NAME=default


# 校验 RTC 云端回调 /api/chat_callback 时带的 Bearer Token，防止别人直接打到你的公网回调地址，不填也能跑，但本服务会跳过鉴权，公网暴露时不建议空着
CUSTOM_LLM_API_KEY=

# Optional system prompt for RAG scene (overrides default neutral persona)
# RAG_SYSTEM_PROMPT=
